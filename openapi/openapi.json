  "info": {
    "title": "Whale ERP API",
    "description": "품목과 재고 이동을 다루는 ERP API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "대소문자는 구분하지 않는다. 저장·조회 모두 소문자로 정규화한다.",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          },
          "deviceIdentifier": {
            "type": "string",
            "description": "기기를 구분하는 값. 같은 기기로 다시 로그인하면 그 기기의 이전 접속만\n종료된다. 없으면 기기 단위로 접속을 정리하지 못한다.",
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AccountStatus": {
        "type": "string",
        "enum": [
          "JOINED",
          "LINK_HOLD",
          "WITHDRAWN"
        ],
        "description": "가입 연결이 보류된 계정(`LINK_HOLD`)도 로그인된다. 이 값이 보류이면 앱은\n관리자 확인 중임을 보여 준다."
      },
      "LoginAccountResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "가입 연결이 보류된 계정(`LINK_HOLD`)도 로그인된다. 이 값이 보류이면 앱은\n관리자 확인 중임을 보여 준다.",
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountStatus"
              }
            ]
          },
          "accountId": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "realName": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "accountId",
          "email",
          "realName"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Authorization: Bearer <accessToken> 으로 API 를 호출한다. 15분 뒤 만료된다."
          },
          "refreshToken": {
            "type": "string",
            "description": "접속을 이어 갈 때 쓴다. 원문은 이 응답에만 있고 서버에는 해시만 남는다."
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "마지막으로 사용한 때부터 30일이 되는 시각. 사용할 때마다 뒤로 밀린다."
          },
          "account": {
            "$ref": "#/components/schemas/LoginAccountResponseDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "refreshTokenExpiresAt",
          "account"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "로그인 응답으로 받은 갱신 토큰.",
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Authorization: Bearer <accessToken> 으로 API 를 호출한다. 15분 뒤 만료된다."
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "갱신 토큰은 새로 주지 않는다. 쓰던 것을 계속 쓰고, 이 시각이 마지막으로\n사용한 때부터 30일이 되는 새 만료 시각이다."
          }
        },
        "required": [
          "accessToken",
          "refreshTokenExpiresAt"
        ]
      },
      "RequestPasswordResetPinDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "비밀번호를 잊은 계정의 이메일. 대소문자는 구분하지 않는다.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyPasswordResetPinDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "pin": {
            "type": "string",
            "description": "메일로 받은 핀. 앞뒤 공백과 대소문자는 서버가 정리한다.",
            "maxLength": 20
          }
        },
        "required": [
          "email",
          "pin"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "pin": {
            "type": "string",
            "description": "핀 확인에 쓴 핀을 다시 보낸다. 서버가 한 번 더 검증한다.",
            "maxLength": 20
          },
          "newPassword": {
            "type": "string",
            "description": "새 비밀번호. 문자 종류와 길이 규칙은 서버가 검사하고 어긋나면 사유를 준다. 여기서는 터무니없이\n긴 입력(scrypt 에 큰 값을 먹이는 일)만 막는다.",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "pin",
          "newPassword"
        ]
      },
      "EnumValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "저장·전송 값. 예: PENDING_SEND"
          },
          "label": {
            "type": "string",
            "description": "화면에 보이는 한글. 예: 발송 대기"
          },
          "order": {
            "type": "number",
            "description": "선택지 순서. 1부터."
          }
        },
        "required": [
          "value",
          "label",
          "order"
        ]
      },
      "EnumCatalogResponseDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "enum 내용의 해시. 내용이 바뀌면 바뀐다 — 클라이언트는 이 값이 같으면 캐시를 그대로 쓴다.",
            "example": "37eab9c919dce591"
          },
          "enums": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EnumValueDto"
              }
            },
            "example": {
              "ContractStatus": [
                {
                  "value": "PENDING_SEND",
                  "label": "발송 대기",
                  "order": 1
                },
                {
                  "value": "PENDING_SIGNATURE",
                  "label": "서명 대기",
                  "order": 2
                },
                {
                  "value": "SIGNED",
                  "label": "체결 완료",
                  "order": 3
                }
              ]
            }
          }
        },
        "required": [
          "version",
          "enums"
        ]
      },
      "UseStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "INACTIVE"
        ],
        "description": "사용 상태."
      },
      "CodeGroupResponseDto": {
        "type": "object",
        "properties": {
          "manageOwnerCode": {
            "type": "string",
            "description": "관리 주체. 공통코드 MANAGE_OWNER 값.",
            "enum": [
              "PLATFORM_FIXED",
              "PLATFORM_PROVIDED"
            ]
          },
          "status": {
            "description": "사용 상태.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UseStatus"
              }
            ]
          },
          "groupCode": {
            "type": "string",
            "description": "그룹 코드.",
            "example": "EMP_TYPE"
          },
          "groupName": {
            "type": "string",
            "description": "그룹명."
          },
          "isBpApplied": {
            "type": "boolean",
            "description": "BP 적용 여부. 플랫폼제공 그룹만 의미가 있다."
          },
          "sortOrder": {
            "type": "number",
            "description": "표시 순서."
          }
        },
        "required": [
          "manageOwnerCode",
          "status",
          "groupCode",
          "groupName",
          "isBpApplied",
          "sortOrder"
        ]
      },
      "CodeGroupListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CodeGroupResponseDto"
            }
          },
          "total": {
            "type": "number",
            "description": "조건에 맞는 전체 건수."
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "UpdateCodeGroupDto": {
        "type": "object",
        "properties": {
          "groupCode": {
            "type": "string",
            "description": "그룹 코드. 수정이면 대상을 가리킬 뿐 바뀌지 않는다.",
            "example": "EMP_TYPE"
          },
          "groupName": {
            "type": "string",
            "description": "그룹명. 앞뒤 공백을 지우고 1~50자.",
            "minLength": 1,
            "maxLength": 50
          },
          "status": {
            "type": "string",
            "description": "사용 상태.",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "sortOrder": {
            "type": "number",
            "description": "표시 순서. 화면이 끌어 옮긴 뒤 1부터 다시 매긴 값.",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "groupCode",
          "groupName",
          "status",
          "sortOrder"
        ]
      },
      "CreateCodeGroupDto": {
        "type": "object",
        "properties": {
          "groupCode": {
            "type": "string",
            "description": "그룹 코드. 수정이면 대상을 가리킬 뿐 바뀌지 않는다.",
            "example": "EMP_TYPE"
          },
          "groupName": {
            "type": "string",
            "description": "그룹명. 앞뒤 공백을 지우고 1~50자.",
            "minLength": 1,
            "maxLength": 50
          },
          "status": {
            "description": "사용 상태.",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "type": "string"
          },
          "sortOrder": {
            "type": "number",
            "description": "표시 순서. 화면이 끌어 옮긴 뒤 1부터 다시 매긴 값.",
            "minimum": 1,
            "maximum": 2147483647
          },
          "manageOwnerCode": {
            "type": "string",
            "description": "관리 주체. 플랫폼고정 · 플랫폼제공만. 등록 뒤 바꾸지 않는다.",
            "enum": [
              "PLATFORM_FIXED",
              "PLATFORM_PROVIDED"
            ]
          }
        },
        "required": [
          "groupCode",
          "groupName",
          "status",
          "sortOrder",
          "manageOwnerCode"
        ]
      },
      "SaveCodeGroupsDto": {
        "type": "object",
        "properties": {
          "updates": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateCodeGroupDto"
            }
          },
          "creates": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateCodeGroupDto"
            }
          }
        },
        "required": [
          "updates",
          "creates"
        ]
      },
      "CodeItemResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "사용 상태.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UseStatus"
              }
            ]
          },
          "itemCode": {
            "type": "string",
            "description": "상세 코드.",
            "example": "FULL"
          },
          "label": {
            "type": "string",
            "description": "코드명.",
            "example": "정규직"
          },
          "sortOrder": {
            "type": "number",
            "description": "표시 순서."
          }
        },
        "required": [
          "status",
          "itemCode",
          "label",
          "sortOrder"
        ]
      },
      "CodeItemListResponseDto": {
        "type": "object",
        "properties": {
