{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/enums": {
      "get": {
        "operationId": "EnumsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnumCatalogResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Enums"
        ]
      }
    },
    "/enums/{name}": {
      "get": {
        "operationId": "EnumsController_findOne",
        "parameters": [
          {
            "name": "name",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnumCatalogResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "그 이름의 enum 이 없다"
          }
        },
        "tags": [
          "Enums"
        ]
      }
    }
  },
  "info": {
    "title": "Whale ERP API",
    "description": "품목과 재고 이동을 다루는 ERP API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "EnumValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "저장·전송 값. 예: PENDING_SEND"
          },
          "label": {
            "type": "string",
            "description": "화면에 보이는 한글. 예: 발송 대기"
          },
          "order": {
            "type": "number",
            "description": "선택지 순서. 1부터."
          }
        },
        "required": [
          "value",
          "label",
          "order"
        ]
      },
      "EnumCatalogResponseDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "enum 내용의 해시. 내용이 바뀌면 바뀐다 — 클라이언트는 이 값이 같으면 캐시를 그대로 쓴다.",
            "example": "37eab9c919dce591"
          },
          "enums": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EnumValueDto"
              }
            },
            "example": {
              "ContractStatus": [
                {
                  "value": "PENDING_SEND",
                  "label": "발송 대기",
                  "order": 1
                },
                {
                  "value": "PENDING_SIGNATURE",
                  "label": "서명 대기",
                  "order": 2
                },
                {
                  "value": "SIGNED",
                  "label": "체결 완료",
                  "order": 3
                }
              ]
            }
          }
        },
        "required": [
          "version",
          "enums"
        ]
      }
    }
  }
}
