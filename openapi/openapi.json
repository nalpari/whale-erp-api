          "total"
        ]
      },
      "CodeItemInputDto": {
        "type": "object",
        "properties": {
          "itemCode": {
            "type": "string",
            "description": "상세 코드. 기존 행이면 대상을 가리킬 뿐 바뀌지 않는다. SERVICE 그룹이면 서비스 코드다.",
            "example": "FULL"
          },
          "label": {
