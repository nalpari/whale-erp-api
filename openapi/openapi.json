          "todosToUnassign": {
            "type": "number",
            "description": "개인으로 배정된 미완료 TO-DO 수 — 배정을 푼다"
          },
          "contractsToEnd": {
            "description": "임시저장 · 발송 대기 · 서명 대기 계약 — 종료로 닫는다",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContractToEndDto"
