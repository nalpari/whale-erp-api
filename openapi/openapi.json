            "example": "정규직",
            "minLength": 1,
            "maxLength": 50
          },
          "status": {
            "type": "string",
            "description": "사용 상태.",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "sortOrder": {
            "type": "number",
            "description": "표시 순서. 화면이 끌어 옮긴 뒤 1부터 다시 매긴 값.",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
