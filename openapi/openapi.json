  "info": {
    "title": "Whale ERP API",
    "description": "품목과 재고 이동을 다루는 ERP API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "대소문자는 구분하지 않는다. 저장·조회 모두 소문자로 정규화한다.",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserType": {
        "type": "string",
        "enum": [
          "staff",
          "customer"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserType"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "email",
          "name"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Authorization: Bearer <accessToken> 으로 API 를 호출한다."
          },
          "refreshToken": {
            "type": "string",
            "description": "액세스 토큰이 만료되면 POST /auth/refresh 에 실어 보낸다."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "로그인 또는 직전 갱신에서 받은 리프레시 토큰."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "DB 는 int(최대 21억)라 number 로 정확히 표현된다."
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "stock": {
            "type": "number",
            "description": "stock_movements 합계로 유도한 현재 재고."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "unit",
          "stock",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateItemDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "M",
              "BOX"
            ]
          }
        },
        "required": [
          "sku",
          "name"
        ]
      },
      "UpdateItemDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "M",
              "BOX"
            ]
          }
        }
      },
      "CreateStockMovementDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "required": [
          "quantity",
          "reason"
        ]
      },
      "MovementResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "itemId": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "description": "입고는 양수, 출고는 음수."
          },
          "reason": {
            "type": "string"
          },
          "stock": {
            "type": "number",
            "description": "이 변동이 반영된 뒤의 재고."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "itemId",
          "quantity",
          "reason",
          "stock",
          "createdAt"
        ]
      },
      "EnumValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "저장·전송 값. 예: PENDING_SEND"
          },
          "label": {
            "type": "string",
            "description": "화면에 보이는 한글. 예: 발송 대기"
          },
          "order": {
            "type": "number",
            "description": "선택지 순서. 1부터."
          }
        },
        "required": [
          "value",
          "label",
          "order"
        ]
      },
      "EnumCatalogResponseDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "enum 내용의 해시. 내용이 바뀌면 바뀐다 — 클라이언트는 이 값이 같으면 캐시를 그대로 쓴다.",
            "example": "37eab9c919dce591"
          },
          "enums": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EnumValueDto"
              }
            },
            "example": {
              "ContractStatus": [
                {
                  "value": "PENDING_SEND",
                  "label": "발송 대기",
                  "order": 1
                },
                {
                  "value": "PENDING_SIGNATURE",
                  "label": "서명 대기",
                  "order": 2
                },
                {
                  "value": "SIGNED",
                  "label": "체결 완료",
                  "order": 3
                }
              ]
            }
          }
        },
        "required": [
          "version",
          "enums"
        ]
      }
    }
  }
}
