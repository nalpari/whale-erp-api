  signDeadlineAt            DateTime?               @map("sign_deadline_at") @db.Timestamptz(6)
  /// 재발송 횟수
  resendCount               Int                     @default(0) @map("resend_count")
  /// 거부 사유
  rejectReason              String?                 @map("reject_reason")
  /// 작성 관리자
  createdBy                 Int                     @map("created_by")
  /// 등록 일시
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 최근 수정 일시
  updatedAt                 DateTime                @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  staffMember               StaffMember             @relation(fields: [staffMemberId], references: [staffMemberId], onDelete: Restrict, onUpdate: NoAction, map: "contracts_staff_member_id_fkey")
  previousContract          Contract?               @relation("Contract_previousContractId", fields: [previousContractId], references: [contractId], onDelete: Restrict, onUpdate: NoAction, map: "contracts_previous_contract_id_fkey")
  contractsAsPrevious       Contract[]              @relation("Contract_previousContractId")
