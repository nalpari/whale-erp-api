  createdAdminAccounts            AdminAccount[]           @relation("AdminAccountsCreatedBy")
  updatedAdminAccounts            AdminAccount[]           @relation("AdminAccountsUpdatedBy")
  sessions                        AdminSession[]           @relation("AdminSessionsAdminAccount")
  createdAdminSessions            AdminSession[]           @relation("AdminSessionsCreatedBy")
  updatedAdminSessions            AdminSession[]           @relation("AdminSessionsUpdatedBy")
  temporaryPasswords              TemporaryPassword[]      @relation("TemporaryPasswordsAdminAccount")
  createdTemporaryPasswords       TemporaryPassword[]      @relation("TemporaryPasswordsCreatedBy")
