  isPinned         Boolean          @default(false) @map("is_pinned")
  /// FAQ 카테고리 — FAQ만
  faqCategoryCode  String?          @map("faq_category_code")
  /// 삭제 표시 — 복구 가능, 무기한 보관
  isDeleted        Boolean          @default(false) @map("is_deleted")
  /// 최종 수정 관리자
  updatedBy        Int?             @map("updated_by")
  /// 최종 수정 일시
  updatedAt        DateTime         @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 등록 관리자
  createdBy        Int?             @map("created_by")
  /// 등록 일시
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  postAudiences    PostAudience[]
  postAttachments  PostAttachment[]

  @@map("posts")
}

/// 노출 대상
model PostAudience {
  /// 노출 대상 ID — 대리키 — 부가서비스 상품을 여럿 고를 수 있게
  postAudienceId Int              @id @default(autoincrement()) @map("post_audience_id")
  /// 게시물
  postId         Int              @map("post_id")
  /// 대상 유형 — 비회원·회원·BP·점포·부가서비스
  audienceType   PostAudienceType @map("audience_type")
  /// 부가서비스 상품 — 부가서비스일 때
  addonCode      String?          @map("addon_code")
  post           Post             @relation(fields: [postId], references: [postId], onDelete: Restrict, onUpdate: NoAction, map: "post_audiences_post_id_fkey")

  @@map("post_audiences")
}

/// 첨부파일
model PostAttachment {
  /// 첨부파일 ID
  postAttachmentId Int      @id @default(autoincrement()) @map("post_attachment_id")
  /// 게시물 — 글당 5개
  postId           Int      @map("post_id")
  /// 파일 이름
  fileName         String   @map("file_name")
  /// 파일 크기 — 10MB 이하
  sizeBytes        Int      @map("size_bytes")
  /// 저장 위치
  storageKey       String   @map("storage_key")
  /// 순서
  sortOrder        Int      @default(0) @map("sort_order")
  /// 삭제 표시
  isDeleted        Boolean  @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post             Post     @relation(fields: [postId], references: [postId], onDelete: Restrict, onUpdate: NoAction, map: "post_attachments_post_id_fkey")

  @@index([postId], map: "post_attachments_post_id_idx")
  @@map("post_attachments")
}

/// 문의사항
model Inquiry {
  /// 문의사항 ID
  inquiryId           Int            @id @default(autoincrement()) @map("inquiry_id")
  /// 등록 관리자 — 본인 문의만 보임
  createdBy           Int            @map("created_by")
  /// 대상 BP — scope_id 를 나눔
  bpCodeId            Int            @map("bp_code_id")
  /// 대상 점포 — 점포 대상일 때
  storeId             Int?           @map("store_id")
  /// 문의 유형
  inquiryCategoryCode String         @map("inquiry_category_code")
  /// 제목
  title               String
  /// 문의 내용
  body                String
  /// 답변 상태 — 접수·처리중·답변완료
  status              InquiryStatus  @default(RECEIVED)
  /// 운영자 내부 메모 — 사용자에게 안 보임
  internalMemo        String?        @map("internal_memo")
  /// 등록 시각
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 최근 수정 일시
  updatedAt           DateTime       @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  inquiryReplies      InquiryReply[]

  @@index([bpCodeId], map: "inquiries_bp_code_id_idx")
  @@map("inquiries")
}

/// 문의 답변
model InquiryReply {
  /// 답변 ID
  inquiryReplyId Int      @id @default(autoincrement()) @map("inquiry_reply_id")
  /// 문의사항 — 답변 이력 전부 보관
  inquiryId      Int      @map("inquiry_id")
  /// 답변 내용
  body           String
  /// 답변 관리자
  repliedBy      Int      @map("replied_by")
  /// 답변 시각
  repliedAt      DateTime @default(now()) @map("replied_at") @db.Timestamptz(6)
  inquiry        Inquiry  @relation(fields: [inquiryId], references: [inquiryId], onDelete: Restrict, onUpdate: NoAction, map: "inquiry_replies_inquiry_id_fkey")

  @@index([inquiryId], map: "inquiry_replies_inquiry_id_idx")
  @@map("inquiry_replies")
}

/// 도입문의
model Lead {
  /// 도입문의 ID
  leadId            Int            @id @default(autoincrement()) @map("lead_id")
  /// 문의자 이름
  contactName       String         @map("contact_name")
  /// 업종 — 목록 선택, 기타는 직접 입력
  industryCode      String         @map("industry_code")
  /// 업종 직접 입력 — 업종이 기타일 때
  industryDetail    String?        @map("industry_detail")
  /// 전화번호 — 휴대전화 아닐 수 있음
  phone             String
  /// 이메일 — 접수 확인 발송
  email             String
  /// 관심 서비스 — 매장운영·재무관리·프랜차이즈·기타
  interests         LeadInterest[]
  /// 도입 예정 시기 — 목록 선택
  planPeriodCode    String?        @map("plan_period_code")
  /// 문의 내용
  body              String
  /// 개인정보 동의 일시 — 필수
  privacyAgreedAt   DateTime       @map("privacy_agreed_at") @db.Timestamptz(6)
  /// 마케팅 동의 일시 — 선택
  marketingAgreedAt DateTime?      @map("marketing_agreed_at") @db.Timestamptz(6)
  /// 답변 상태
  status            InquiryStatus  @default(RECEIVED)
  /// 사용자 노출 답변 — 이메일로 회신
  reply             String?
  /// 운영자 내부 메모
  internalMemo      String?        @map("internal_memo")
  /// 접수 일시
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 상담 완료일 — 1년 뒤 파기
  consultedDate     DateTime?      @map("consulted_date") @db.Date

  @@map("leads")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1팀 1차 물리 모델 — whale-erp-new-front 의 docs/erd/team1/schema.sql 을 Prisma 로 옮긴 것.
// 원본은 그 저장소의 docs/erd/team1/_build_physical.py 생성기다. 손으로 고치지 말고
// ERD 를 고쳐 다시 만든다.
//
// Prisma 가 표현하지 못해 SQL 에만 있는 것: CHECK 32, 부분 고유 인덱스 5.
// 그 원문은 prisma/migrations/20261006000000_team1_initial/migration.sql 이고,
// db:pull 로 이 파일을 덮어써도 되살아나지 않는다.
// 기본키는 SQL 에서 GENERATED ALWAYS AS IDENTITY 다(여기서는 autoincrement 로 보인다).
//
// 3팀 모델이 정수 컬럼으로만 들고 있는 store_id · bp_code_id · admin_account_id · *_by 는
// 여기서도 관계로 잇지 않는다 — 두 묶음을 따로 두기로 한 결정(ae1e472)을 그대로 둔다.
// ═══════════════════════════════════════════════════════════════════════════

/// 임시비밀번호 · 초기비밀번호 · 비밀번호초기화
enum TemporaryPasswordPurpose {
  TEMPORARY
  INITIAL
  RESET
}

/// 불일치 · 잠금 · 미사용 · 탈퇴
enum LoginFailureReason {
  PASSWORD_MISMATCH
  LOCKED
  INACTIVE
  WITHDRAWN
}

/// 회원가입 · 최초 로그인 · 재동의 · 약관변경
enum TermsAgreementChannel {
  SIGNUP
  FIRST_LOGIN
  REAGREEMENT
  TERMS_CHANGED
}

/// 성공 · 실패
enum ProcessResult {
  SUCCEEDED
  FAILED
}

/// 사용 · 사용중지
enum UseStatus {
  ACTIVE
  INACTIVE
}

/// 없음 · 날짜 · 횟수
enum RepeatEndType {
  NONE
  UNTIL_DATE
  COUNT
}

/// JPG · PNG
enum StoreImageFileType {
  JPG
  PNG
}

/// 규칙 계산 · 공식 API
enum PublicHolidaySource {
  RULE
  PUBLIC_API
}

/// 약관 버전
model TermsVersion {
  /// 약관 버전 ID
  termsVersionId Int      @id @default(autoincrement()) @map("terms_version_id")
  /// 약관 유형 코드 — 공통코드 `TERMS_TYPE`(`TERMS_SERVICE` 이용약관(BP 회원가입용)·`PRIVACY_COLLECT` 개인정보 수집·이용 동의(BP 회원가입용)·`STAFF_TERMS_SERVICE` 이용약관(직원 앱 회원가입용)·`STAFF_PRIVACY` 개인정보 수집·이용 동의(직원 앱 회원가입용)·`MARKETING` 마케팅 수신 동의·`LOCATION` 위치정보 수집·이용 동의)
  termsTypeCode  String   @map("terms_type_code")
  /// 버전 번호 — 예: v1.0, v1.1
  version        String
  /// 약관 내용 — 약관 본문
  content        String
  /// 제목
  title          String
  /// 시행일
  effectiveDate  DateTime @map("effective_date") @db.Date
  /// 사용 여부 — 현재 적용 중인 버전
  isActive       Boolean  @default(false) @map("is_active")
  /// 삭제 여부
  isDeleted      Boolean  @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy      Int?     @map("created_by")
  /// 최근 수정 일시
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy      Int?     @map("updated_by")

  creator AdminAccount? @relation("TermsVersionsCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "terms_versions_created_by_fkey")
  updater AdminAccount? @relation("TermsVersionsUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "terms_versions_updated_by_fkey")

  termsOfUseAgreedAdminAccounts AdminAccount[]      @relation("AdminAccountsTermsOfUseVersion")
  privacyAgreedAdminAccounts    AdminAccount[]      @relation("AdminAccountsPrivacyVersion")
  agreementLogs                 TermsAgreementLog[] @relation("TermsAgreementLogsTermsVersion")

  @@unique([termsTypeCode, version], map: "terms_versions_terms_type_code_version_key")
  @@map("terms_versions")
}

/// BP 코드
model BpCode {
  /// BP ID
  bpCodeId              Int       @id @default(autoincrement()) @map("bp_code_id")
  /// BP 코드 — BP+6자리, 고유, 자동 채번, 변경 불가. 플랫폼 BP 는 BP000000 예약(채번 제외)
  bpCode                String    @map("bp_code")
  /// 플랫폼 BP 여부 — 기본 false. true 인 행은 하나만(부분 유일)
  isPlatform            Boolean   @default(false) @map("is_platform")
  /// BP 상태 코드 — 공통코드 `ACCOUNT_STATUS`(사용·미사용·탈퇴), 기본 사용. 시스템만 변경, 플랫폼 BP 는 사용 고정
  accountStatusCode     String    @map("account_status_code")
  /// 상호명 — 1~50자
  tradeName             String    @map("trade_name")
  /// 사업자등록번호 — 탈퇴하지 않은 고객 BP끼리 고유(부분 유일). 플랫폼 BP 는 검사에서 제외
  bizRegistrationNumber String?   @map("biz_registration_number")
  /// 대표자명 — 인증 결과만
  bizCeoName            String?   @map("biz_ceo_name")
  /// 개업일자 — 인증 결과만
  bizOpenDate           DateTime? @map("biz_open_date") @db.Date
  /// 대표자 연락처 — BP 탈퇴 때 삭제(개인정보)
  bizCeoPhone           String?   @map("biz_ceo_phone")
  /// 대표자 이메일 — BP 탈퇴 때 삭제(개인정보)
  bizCeoEmail           String?   @map("biz_ceo_email")
  /// 사업장 우편번호
  bizZipCode            String?   @map("biz_zip_code")
  /// 사업장 기본주소
  bizAddress            String?   @map("biz_address")
  /// 사업장 상세주소
  bizAddressDetail      String?   @map("biz_address_detail")
  /// 업태 — 50자
  bizCategory           String?   @map("biz_category")
  /// 종목 — 50자
  bizItem               String?   @map("biz_item")
  /// 최종 인증일시
  bizVerifiedAt         DateTime? @map("biz_verified_at") @db.Timestamptz(6)
  /// 삭제 여부 — 오등록 BP 삭제 때만 true. BP 탈퇴는 바꾸지 않음
  isDeleted             Boolean   @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy             Int?      @map("created_by")
  /// 최근 수정 일시
  updatedAt             DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy             Int?      @map("updated_by")

  creator AdminAccount? @relation("BpCodesCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "bp_codes_created_by_fkey")
  updater AdminAccount? @relation("BpCodesUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "bp_codes_updated_by_fkey")

  adminAccounts   AdminAccount[]    @relation("AdminAccountsBpCode")
  stores          Store[]           @relation("StoresBpCode")
  changeHistories BpChangeHistory[] @relation("BpChangeHistoriesBpCode")
  roleGroups      RoleGroup[]       @relation("RoleGroupsBpCode")
  codeItems       CodeItem[]        @relation("CodeItemsBpCode")
  bpHolidays      BpHoliday[]       @relation("BpHolidaysBpCode")

  @@unique([bpCode], map: "bp_codes_bp_code_key")
  @@map("bp_codes")
}

/// 관리자 계정
model AdminAccount {
  /// 관리자 ID
  adminAccountId           Int       @id @default(autoincrement()) @map("admin_account_id")
  /// 관리자 로그인ID — 영문·숫자 4~20자, 탈퇴·삭제 포함 고유, 변경 불가
  loginId                  String    @map("login_id")
  /// BP — bp_codes FK, 필수. 플랫폼 마스터·플랫폼 관리자는 플랫폼 BP
  bpCodeId                 Int       @map("bp_code_id")
  /// 이름 — 한글·영문 2~20자
  name                     String?
  /// 비밀번호 해시
  passwordHash             String    @map("password_hash")
  /// 연락처 — 숫자 10~11자리
  phone                    String?
  /// 이메일 — 사용·미사용 계정 간 고유
  email                    String?
  /// 권한 유형 코드 — 공통코드 `ROLE_TYPE`(플랫폼 마스터·플랫폼 관리자·BP 마스터·BP 관리자·가맹 마스터·가맹 관리자)
  roleTypeCode             String    @map("role_type_code")
  /// 권한 그룹 — 한 명에 하나
  roleGroupId              Int       @map("role_group_id")
  /// 이용약관 최근 동의 버전 — terms_versions FK, 동의 전(플랫폼등록 계정 첫 로그인 전)은 비움
  termsOfUseVersionId      Int?      @map("terms_of_use_version_id")
  /// 이용약관 동의 일시
  termsOfUseAgreedAt       DateTime? @map("terms_of_use_agreed_at") @db.Timestamptz(6)
  /// 개인정보 최근 동의 버전 — terms_versions FK, 동의 전은 비움
  privacyVersionId         Int?      @map("privacy_version_id")
  /// 개인정보 동의 일시
  privacyAgreedAt          DateTime? @map("privacy_agreed_at") @db.Timestamptz(6)
  /// 약관 최근 동의 일시 — 이용약관과 개인정보 수집·이용 동의한 일시
  termsAgreedAt            DateTime? @map("terms_agreed_at") @db.Timestamptz(6)
  /// 강제 비밀번호 변경 대상 — 초기·임시 비밀번호 발급 시 true
  isPasswordChangeRequired Boolean   @default(false) @map("is_password_change_required")
  /// 초기 비밀번호 미발송 — 계정 생성·초기화 메일이 실패하면 true, 다시 보내면 false
  isInitialPasswordUnsent  Boolean   @default(false) @map("is_initial_password_unsent")
  /// 로그인 실패 횟수 — 5회 잠금
  failedLoginCount         Int       @default(0) @map("failed_login_count")
  /// 잠금 해제 시각 — 5분 잠금
  lockExpiresAt            DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  /// 최근 로그인 일시
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// 가입경로 코드 — 공통코드 `JOIN_PATH`(회원가입·플랫폼등록), 모든 계정 필수
  joinPathCode             String    @map("join_path_code")
  /// 전체 점포 적용 여부 — true 면 소속 BP 모든 점포(이후 등록 포함)를 관리하고 점포 매핑을 두지 않음. false 면 `admin_store_mappings`. 가맹 마스터는 false 만
  isAllStores              Boolean   @default(false) @map("is_all_stores")
  /// 소속 부서 — 플랫폼 관리자만, 선택
  department               String?
  /// 직책 — 플랫폼 관리자만, 선택
  jobTitle                 String?   @map("job_title")
  /// 우편번호 — 플랫폼 관리자만, 선택
  zipCode                  String?   @map("zip_code")
  /// 기본주소 — 플랫폼 관리자만, 선택
  address                  String?
  /// 상세주소 — 플랫폼 관리자만, 선택
  addressDetail            String?   @map("address_detail")
  /// 탈퇴 사유 코드 — 공통코드 `WITHDRAW_REASON`(WD_CLOSE 등 탈퇴 사유)
  withdrawReasonCode       String?   @map("withdraw_reason_code")
  /// 탈퇴사유설명 — 직접입력 시 500자
  withdrawReasonDetail     String?   @map("withdraw_reason_detail")
  /// 계정 상태 코드 — 공통코드 `ACCOUNT_STATUS`(사용·미사용·탈퇴). BP 마스터 계정은 `bp_codes.account_status_code` 와 같은 트랜잭션에서 함께 바뀐다
  accountStatusCode        String    @map("account_status_code")
  /// 계정상태변경일시 — 탈퇴 일시도 여기에 남는다. BP 가 탈퇴하면 하위 계정(BP 관리자·가맹 마스터·가맹 관리자)도 같은 순간 탈퇴하고 개인정보를 지운다 — 아이디만 보존
  statusChangedAt          DateTime? @map("status_changed_at") @db.Timestamptz(6)
  /// 삭제 여부 — 오등록 삭제용, 논리 삭제. 회원 탈퇴는 바꾸지 않음(상태만 탈퇴)
  isDeleted                Boolean   @default(false) @map("is_deleted")
  /// 등록 일시
