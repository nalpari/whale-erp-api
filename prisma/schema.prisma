/// 관리자 접속 상태
model AdminSession {
  /// 접속 ID
  sessionId         Int       @id @default(autoincrement()) @map("session_id")
  /// 관리자
  adminAccountId    Int       @map("admin_account_id")
  /// 기기 식별 정보 — 여러 브라우저 동시 로그인
  deviceInformation String?   @map("device_information")
  /// 접근 토큰 해시 — 1시간
  accessTokenHash   String    @map("access_token_hash")
  /// 갱신 토큰 해시 — 마지막 사용 후 1시간
  refreshTokenHash  String    @map("refresh_token_hash")
  /// 갱신 토큰 마지막 사용 시각 — 여기서 1시간이 지나면 만료
  refreshLastUsedAt DateTime  @map("refresh_last_used_at") @db.Timestamptz(6)
  /// 발급 시각
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 만료 시각
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  /// 종료 시각 — 로그아웃·비밀번호 변경 시
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// 삭제 여부
  isDeleted         Boolean   @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy         Int?      @map("created_by")
  /// 최근 수정 일시
  updatedAt         DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy         Int?      @map("updated_by")

  adminAccount AdminAccount  @relation("AdminSessionsAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_sessions_admin_account_id_fkey")
  creator      AdminAccount? @relation("AdminSessionsCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_sessions_created_by_fkey")
  updater      AdminAccount? @relation("AdminSessionsUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_sessions_updated_by_fkey")

  @@index([adminAccountId], map: "admin_sessions_admin_account_id_idx")
  @@map("admin_sessions")
}

/// 임시 비밀번호
model TemporaryPassword {
  /// 임시 비밀번호 ID
  temporaryPasswordId Int                      @id @default(autoincrement()) @map("temporary_password_id")
  /// 관리자
  adminAccountId      Int                      @map("admin_account_id")
  /// 비밀번호 해시 — 12자 무작위
  passwordHash        String                   @map("password_hash")
  /// 발급 시각
  issuedAt            DateTime                 @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 만료 시각 — 1시간 — 임시·초기·초기화 모두
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  /// 사용 시각 — 로그인 성공 시
  usedAt              DateTime?                @map("used_at") @db.Timestamptz(6)
  /// 무효화 시각 — 다시 발급하거나 비밀번호를 바꾸면
  invalidatedAt       DateTime?                @map("invalidated_at") @db.Timestamptz(6)
  /// 발급 용도 — 임시비밀번호·초기비밀번호·비밀번호초기화. 찾기 발급 제한(계정당 1시간 5회)은 임시비밀번호만 센다
  purpose             TemporaryPasswordPurpose
  /// 삭제 여부
  isDeleted           Boolean                  @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy           Int?                     @map("created_by")
  /// 최근 수정 일시
  updatedAt           DateTime                 @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy           Int?                     @map("updated_by")

  adminAccount AdminAccount  @relation("TemporaryPasswordsAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "temporary_passwords_admin_account_id_fkey")
  creator      AdminAccount? @relation("TemporaryPasswordsCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "temporary_passwords_created_by_fkey")
  updater      AdminAccount? @relation("TemporaryPasswordsUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "temporary_passwords_updated_by_fkey")

  @@index([adminAccountId], map: "temporary_passwords_admin_account_id_idx")
  @@map("temporary_passwords")
}

/// 관리자 로그인 이력
model AdminLoginLog {
  /// 로그인 이력 ID
  loginId        Int                 @id @default(autoincrement()) @map("login_id")
  /// 관리자 — 없는 아이디면 비움
  adminAccountId Int?                @map("admin_account_id")
  /// 접속 IP
  clientAddress  String?             @map("client_address")
  /// 성공 여부
  isSucceeded    Boolean             @default(false) @map("is_succeeded")
  /// 실패 사유 — 불일치·잠금·미사용·탈퇴
  failureReason  LoginFailureReason? @map("failure_reason")
  /// 시도 시각 — 1년 보존
  attemptedAt    DateTime            @default(now()) @map("attempted_at") @db.Timestamptz(6)

  adminAccount AdminAccount? @relation("AdminLoginLogsAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_login_logs_admin_account_id_fkey")

  @@index([adminAccountId, attemptedAt], map: "admin_login_logs_admin_account_id_attempted_at_idx")
  @@map("admin_login_logs")
}

/// 관리자 변경 이력
model AdminChangeHistory {
  /// 변경 이력 ID
  changeId       Int      @id @default(autoincrement()) @map("change_id")
  /// 대상 관리자
  adminAccountId Int      @map("admin_account_id")
  /// 변경 항목 — 이름·연락처·이메일·계정상태 등
  field          String
  /// 변경 전 값 — 비밀번호는 저장 안 함
  beforeValue    String?  @map("before_value")
  /// 변경 후 값 — 비밀번호는 저장 안 함
  afterValue     String?  @map("after_value")
  /// 변경자 — 본인 또는 관리자. 연쇄 미사용은 미사용 처리한 사람
  changedBy      Int?     @map("changed_by")
  /// 변경 일시 — 5년 보존
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  adminAccount AdminAccount  @relation("AdminChangeHistoriesAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_change_histories_admin_account_id_fkey")
  changer      AdminAccount? @relation("AdminChangeHistoriesChangedBy", fields: [changedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "admin_change_histories_changed_by_fkey")

  @@index([adminAccountId, changedAt], map: "admin_change_histories_admin_account_id_changed_at_idx")
  @@map("admin_change_histories")
}

/// 약관 동의 이력
model TermsAgreementLog {
  /// 동의 이력 ID
  agreementId    Int                   @id @default(autoincrement()) @map("agreement_id")
  /// 관리자 — admin_accounts FK
  adminAccountId Int                   @map("admin_account_id")
  /// 약관 버전 — terms_versions FK
  termsVersionId Int                   @map("terms_version_id")
  /// 동의 여부
  isAgreed       Boolean               @default(false) @map("is_agreed")
  /// 동의 일시
  agreedAt       DateTime              @default(now()) @map("agreed_at") @db.Timestamptz(6)
  /// 동의 경로 — 회원가입·최초 로그인·재동의·약관변경
  channel        TermsAgreementChannel
  /// 접속 IP
  clientAddress  String?               @map("client_address")

  adminAccount AdminAccount @relation("TermsAgreementLogsAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "terms_agreement_logs_admin_account_id_fkey")
  termsVersion TermsVersion @relation("TermsAgreementLogsTermsVersion", fields: [termsVersionId], references: [termsVersionId], onDelete: Restrict, onUpdate: NoAction, map: "terms_agreement_logs_terms_version_id_fkey")

  @@index([adminAccountId], map: "terms_agreement_logs_admin_account_id_idx")
  @@map("terms_agreement_logs")
}

/// 메일 발송 이력
model MailSendLog {
  /// 발송 이력 ID
  mailId         Int           @id @default(autoincrement()) @map("mail_id")
  /// 메일 유형 코드 — 공통코드 `MAIL_TYPE`(회원가입 완료·신규 BP 가입 알림·BP 신규 등록·플랫폼 관리자 계정 생성·BP 관리자 계정 생성·비밀번호 초기화·임시 비밀번호 발급·회원 탈퇴 완료)
  mailTypeCode   String        @map("mail_type_code")
  /// 수신 계정 — admin_accounts FK
  adminAccountId Int?          @map("admin_account_id")
  /// 발신 이메일 — 보낸 주소
  fromEmail      String        @map("from_email")
  /// 수신 이메일 — 보낸 시점의 주소
  toEmail        String        @map("to_email")
  /// 메일 제목 — 보낸 제목 그대로
  subject        String
  /// 메일 내용 — 보낸 본문. 초기·임시 비밀번호 값은 `********`로 가려서 저장
  body           String
  /// 발송 결과 — 성공·실패
  result         ProcessResult
  /// 실패 사유
  failureReason  String?       @map("failure_reason")
  /// 처리자 — 관리자가 보냈을 때, 본인 요청은 비움
  sentBy         Int?          @map("sent_by")
  /// 발송 일시 — 1년 보존
  sentAt         DateTime      @default(now()) @map("sent_at") @db.Timestamptz(6)

  adminAccount AdminAccount? @relation("MailSendLogsAdminAccount", fields: [adminAccountId], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "mail_send_logs_admin_account_id_fkey")
  sender       AdminAccount? @relation("MailSendLogsSentBy", fields: [sentBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "mail_send_logs_sent_by_fkey")

  @@index([adminAccountId, sentAt], map: "mail_send_logs_admin_account_id_sent_at_idx")
  @@map("mail_send_logs")
}

/// 점포
model Store {
  /// 점포 ID
  storeId           Int       @id @default(autoincrement()) @map("store_id")
  /// 점포코드 — ST+6자리, 고유, 자동 채번, 변경 불가
  storeCode         String    @map("store_code")
  /// BP — 소속 BP, bp_codes FK
  bpCodeId          Int       @map("bp_code_id")
  /// 점포 유형 코드 — 공통코드 `STORE_TYPE`(DIRECT 직영점포·FRANCHISE 가맹점포), 변경 불가
  storeTypeCode     String    @map("store_type_code")
  /// 점포명 — 1~50자, 필수
  name              String
  /// 점포 연락처 — 숫자 9~11자리
  phone             String?
  /// 우편번호
  zipCode           String?   @map("zip_code")
  /// 기본주소
  address           String?
  /// 상세주소
  addressDetail     String?   @map("address_detail")
  /// 위도 — 소수점 6자리
  latitude          Decimal?  @db.Decimal(8, 6)
  /// 경도 — 소수점 6자리
  longitude         Decimal?  @db.Decimal(9, 6)
  /// 위치 적용 여부 — 기본 true(사용). true 면 3팀이 위도·경도 기준으로 출퇴근 허용 여부를 판정, false 면 위치를 보지 않음
  isLocationApplied Boolean   @default(true) @map("is_location_applied")
  /// 폐점일 — 폐점 전환일 자동
  closedDate        DateTime? @map("closed_date") @db.Date
  /// 점포 상태 코드 — 공통코드 `STORE_STATUS`(미운영·운영·폐점)
  storeStatusCode   String    @map("store_status_code")
  /// 삭제 여부 — 미운영만 삭제 가능
  isDeleted         Boolean   @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자
  createdBy         Int?      @map("created_by")
  /// 최근 수정 일시
  updatedAt         DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자
  updatedBy         Int?      @map("updated_by")

  bpCode  BpCode        @relation("StoresBpCode", fields: [bpCodeId], references: [bpCodeId], onDelete: Restrict, onUpdate: NoAction, map: "stores_bp_code_id_fkey")
  creator AdminAccount? @relation("StoresCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "stores_created_by_fkey")
  updater AdminAccount? @relation("StoresUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "stores_updated_by_fkey")

  floors            StoreFloor[]           @relation("StoreFloorsStore")
  imageFiles        StoreImageFile[]       @relation("StoreImageFilesStore")
  businessProfile   StoreBusinessProfile?  @relation("StoreBusinessProfilesStore")
  changeHistories   StoreChangeHistory[]   @relation("StoreChangeHistoriesStore")
  adminMappings     AdminStoreMapping[]    @relation("AdminStoreMappingsStore")
  holidayMappings   HolidayStoreMapping[]  @relation("HolidayStoreMappingsStore")
  holidayExclusions HolidayExcludedStore[] @relation("HolidayExcludedStoresStore")

  @@unique([storeCode], map: "stores_store_code_key")
  @@index([bpCodeId], map: "stores_bp_code_id_idx")
  @@map("stores")
}

/// 점포 층별정보
model StoreFloor {
  /// 층별정보 ID
  storeFloorId    Int      @id @default(autoincrement()) @map("store_floor_id")
  /// 점포 — stores FK
  storeId         Int      @map("store_id")
  /// 매장평수 — 소수 1자리, 선택
  floorAreaPyeong Decimal? @map("floor_area_pyeong") @db.Decimal(8, 1)
  /// 전용면적 — 소수 2자리, 선택
  floorAreaSqm    Decimal? @map("floor_area_sqm") @db.Decimal(10, 2)
  /// 좌석수 — 0 이상, 선택
  seatCount       Int?     @map("seat_count")
  /// 층수 구분 코드 — 공통코드 `FLOOR_TYPE`(GROUND 지상·BASEMENT 지하)
  floorTypeCode   String?  @map("floor_type_code")
  /// 층수
  floorNumber     Int?     @map("floor_number")
  /// 삭제 여부
  isDeleted       Boolean  @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy       Int?     @map("created_by")
  /// 최근 수정 일시
  updatedAt       DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy       Int?     @map("updated_by")

  store   Store         @relation("StoreFloorsStore", fields: [storeId], references: [storeId], onDelete: Restrict, onUpdate: NoAction, map: "store_floors_store_id_fkey")
  creator AdminAccount? @relation("StoreFloorsCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "store_floors_created_by_fkey")
  updater AdminAccount? @relation("StoreFloorsUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "store_floors_updated_by_fkey")

  @@index([storeId], map: "store_floors_store_id_idx")
  @@map("store_floors")
}

/// 점포 대표 이미지 파일
model StoreImageFile {
  /// 파일 ID
  fileId     Int                @id @default(autoincrement()) @map("file_id")
  /// 점포 — stores FK, 삭제되지 않은 행은 점포당 1개
  storeId    Int                @map("store_id")
  /// 원본 파일명
  fileName   String             @map("file_name")
  /// 파일 구분 — JPG·PNG
  fileType   StoreImageFileType @map("file_type")
