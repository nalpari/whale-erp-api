/// 급여명세서
model Payslip {
  /// 급여명세서 ID
  payslipId            Int                   @id @default(autoincrement()) @map("payslip_id")
  /// 직원 레코드 — 같은 기간 중복 생성 차단
  staffMemberId        Int                   @map("staff_member_id")
  /// 근무지
  storeId              Int                   @map("store_id")
  /// 참조 근로계약 — 계약 없으면 초안 없음
  contractId           Int                   @map("contract_id")
  /// 급여 기간 시작일
  periodStartDate      DateTime              @map("period_start_date") @db.Date
  /// 급여 기간 종료일
  periodEndDate        DateTime              @map("period_end_date") @db.Date
  /// 계약 유형
  employmentType       EmploymentType        @map("employment_type")
  /// 출퇴근 참조 시작일
  attendanceStartDate  DateTime              @map("attendance_start_date") @db.Date
  /// 출퇴근 참조 종료일
  attendanceEndDate    DateTime              @map("attendance_end_date") @db.Date
  /// 명세서 상태 — 작성 중·검토 중·확정·발송 완료
  status               PayslipStatus         @default(DRAFTING)
  /// 연장·야간·휴일 가산 — 적용 여부·명세서마다 정함
  isPremiumApplied     Boolean               @default(true) @map("is_premium_applied")
  /// 3.3% 원천징수 적용 — 파트타이머는 적용으로 시작, 명세서마다 끈다 (운영 정책 PAY-03)
  isWithholdingApplied Boolean               @default(false) @map("is_withholding_applied")
  /// 지급 총액
  grossPayAmount       Int                   @default(0) @map("gross_pay_amount")
  /// 공제 총액
  totalDeductionAmount Int                   @default(0) @map("total_deduction_amount")
  /// 실지급액
  netPayAmount         Int                   @default(0) @map("net_pay_amount")
  /// 확정 일시
  confirmedAt          DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  /// 확정 관리자
  confirmedBy          Int?                  @map("confirmed_by")
  /// 생성 일시
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 최근 수정 일시
  updatedAt            DateTime              @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  staffMember          StaffMember           @relation(fields: [staffMemberId], references: [staffMemberId], onDelete: Restrict, onUpdate: NoAction, map: "payslips_staff_member_id_fkey")
  contract             Contract              @relation(fields: [contractId], references: [contractId], onDelete: Restrict, onUpdate: NoAction, map: "payslips_contract_id_fkey")
  payslipItems         PayslipItem[]
  payslipReviewReasons PayslipReviewReason[]
  payslipDispatches    PayslipDispatch[]
  payslipLogs          PayslipLog[]

  @@unique([staffMemberId, periodStartDate, periodEndDate], map: "payslips_staff_member_id_period_start_date_period_end_date_key")
  @@index([storeId, periodStartDate], map: "payslips_store_id_period_start_date_idx")
  @@map("payslips")
}

