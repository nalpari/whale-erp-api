generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 주의: items 와 stock_movements 의 CHECK 제약은 Prisma 스키마 언어로 표현할 수 없다.
/// 제약의 진실은 prisma/migrations/0_init/migration.sql 에 있으며, db pull 로
/// 이 파일을 덮어써도 제약은 되살아나지 않는다. 제약을 바꾸려면 마이그레이션 SQL 을 직접 쓴다.
model Item {
  id        Int             @id @default(autoincrement())
  sku       String          @unique
  name      String
  unit      String          @default("EA")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  movements StockMovement[]

  @@map("items")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  quantity  Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([itemId, id], map: "stock_movements_item_id_idx")
  @@map("stock_movements")
}
