/// 근로계약
model Contract {
  /// 근로계약 ID
  contractId                Int                     @id @default(autoincrement()) @map("contract_id")
  /// 직원 레코드
  staffMemberId             Int                     @map("staff_member_id")
  /// 근무지
  storeId                   Int                     @map("store_id")
  /// 직전 계약 — 재계약일 때
  previousContractId        Int?                    @map("previous_contract_id")
  /// 계약 유형 — 정직원·파트타이머
  employmentType            EmploymentType          @map("employment_type")
  /// 계약 방식 — ELECTRONIC·PAPER (CTR-23)
  contractMethod            ContractMethod          @map("contract_method")
  /// 계약 시작일 — 종료일 비우면 무기한
  startDate                 DateTime                @map("start_date") @db.Date
  /// 계약 종료일 — 종료일 비우면 무기한
  endDate                   DateTime?               @map("end_date") @db.Date
  /// 근무 조건 — 근무요일(월~일)·시작·종료·휴게, 30분 단위
  workTerms                 Json                    @map("work_terms")
  /// 주휴일 — 근무요일과 함께 초안에서 정한다 (2026-10-06 재영, 컬럼 유지)
  weeklyHoliday             Weekday?                @map("weekly_holiday")
  /// 건강보험·국민연금 가입
  isHealthPensionInsured    Boolean                 @default(false) @map("is_health_pension_insured")
  /// 고용보험·산재보험 가입
  isEmploymentInjuryInsured Boolean                 @default(false) @map("is_employment_injury_insured")
  /// 급여 조건 — 시급·월급·지급일
  wageTerms                 Json                    @map("wage_terms")
  /// 계약 상태 — 발송 대기·서명 대기·체결 완료·거부·만료·종료
  status                    ContractStatus          @default(PENDING_SEND)
  /// 초안 처리 유형 — 가입 초대·소속 추가 확인·복귀 확인·즉시 발송
  draftAction               ContractDraftAction?    @map("draft_action")
  /// 발송 일시
  sentAt                    DateTime?               @map("sent_at") @db.Timestamptz(6)
  /// 날인 기한 — 발송일부터 30일
  signDeadlineAt            DateTime?               @map("sign_deadline_at") @db.Timestamptz(6)
  /// 재발송 횟수
  resendCount               Int                     @default(0) @map("resend_count")
  /// 거부 사유
  rejectReason              String?                 @map("reject_reason")
  /// 작성 관리자
  createdBy                 Int                     @map("created_by")
  /// 등록 일시
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 최근 수정 일시
  updatedAt                 DateTime                @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  staffMember               StaffMember             @relation(fields: [staffMemberId], references: [staffMemberId], onDelete: Restrict, onUpdate: NoAction, map: "contracts_staff_member_id_fkey")
  previousContract          Contract?               @relation("Contract_previousContractId", fields: [previousContractId], references: [contractId], onDelete: Restrict, onUpdate: NoAction, map: "contracts_previous_contract_id_fkey")
  contractsAsPrevious       Contract[]              @relation("Contract_previousContractId")
  contractParty             ContractParty?
  contractDocuments         ContractDocument[]
  contractStatusHistories   ContractStatusHistory[]
  workSchedulesAsSource     WorkSchedule[]
  payslips                  Payslip[]

  @@index([staffMemberId], map: "contracts_staff_member_id_idx")
  @@index([storeId, status], map: "contracts_store_id_status_idx")
  @@map("contracts")
}

