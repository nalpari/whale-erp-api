/// 본인인증 이력
model IdentityVerification {
  /// 본인인증 ID
  identityVerificationId Int                         @id @default(autoincrement()) @map("identity_verification_id")
  /// 계정
  accountId              Int?                        @map("account_id")
  /// 인증 목적 — 가입·휴대전화번호 변경
  purpose                IdentityVerificationPurpose
  /// 인증 휴대전화번호
  phone                  String
  /// 인증 결과
  result                 IdentityVerificationResult
  /// 인증 일시
  verifiedAt             DateTime                    @default(now()) @map("verified_at") @db.Timestamptz(6)
  account                Account?                    @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: NoAction, map: "identity_verifications_account_id_fkey")

  @@index([accountId], map: "identity_verifications_account_id_idx")
  @@map("identity_verifications")
}

/// 접속 상태
model AuthSession {
  /// 접속 ID
  authSessionId    Int       @id @default(autoincrement()) @map("auth_session_id")
  /// 계정
  accountId        Int       @map("account_id")
  /// 기기 식별 정보 — 한 계정 여러 기기
  deviceIdentifier String?   @map("device_identifier")
  /// 갱신 토큰 해시 — sha256. 한 기기 한 행 — 여러 기기 30일 유지
  refreshTokenHash String    @map("refresh_token_hash")
  /// 발급 시각
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 마지막 사용 시각 — 만료는 마지막 사용 + 30일
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// 만료 시각 — 마지막 접속 후 30일
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  /// 종료 시각 — 재설정 시 모두 종료
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  account          Account   @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: NoAction, map: "auth_sessions_account_id_fkey")

  @@unique([refreshTokenHash], map: "auth_sessions_refresh_token_hash_key")
  @@index([accountId], map: "auth_sessions_account_id_idx")
  @@map("auth_sessions")
}

/// 계정
model Account {
  /// 계정 ID
  accountId               Int                      @id @default(autoincrement()) @map("account_id")
  /// 이메일 아이디 — 로그인 아이디, 고유
  email                   String
  /// 비밀번호 해시
  passwordHash            String                   @map("password_hash")
  /// 실명 — 본인인증 값, 수정 불가
  realName                String                   @map("real_name")
  /// 생년월일 — 본인인증 값, 수정 불가
  birthDate               DateTime                 @map("birth_date") @db.Date
  /// 휴대전화번호 — 본인인증, 변경 시 재인증
  phone                   String
  /// 동일인 식별값
  connectingInformation   String?                  @map("connecting_information")
  /// 우편번호 — 외부 주소 검색 API 값 (ME-2)
  zipCode                 String?                  @map("zip_code")
  /// 기본주소 — 도로명 주소, 검색 API 값
  address                 String?
  /// 상세주소 — 직접 입력
  addressDetail           String?                  @map("address_detail")
  /// 계정 상태 — 가입 완료·연결 보류
  status                  AccountStatus
  /// 로그인 실패 횟수 — 5회 잠금
  failedLoginCount        Int                      @default(0) @map("failed_login_count")
  /// 잠금 해제 시각 — 재설정하면 해제
  lockExpiresAt           DateTime?                @map("lock_expires_at") @db.Timestamptz(6)
  /// 가입 일시
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 최근 수정 일시
  updatedAt               DateTime                 @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  identityVerifications   IdentityVerification[]
  authSessions            AuthSession[]
  accountChangeHistories  AccountChangeHistory[]
  loginHistories          LoginHistory[]
  passwordResetPins       PasswordResetPin[]
  locationAccessLogs      LocationAccessLog[]
  staffMembers            StaffMember[]            @relation("StaffMember_accountId")
  staffMembersAsCandidate StaffMember[]            @relation("StaffMember_candidateAccountId")
  linkHolds               LinkHold[]
  locationConsents        LocationConsent[]
  notificationRecipients  NotificationRecipient[]
  notificationPreferences NotificationPreference[]

  @@unique([email], map: "accounts_email_key")
  @@unique([connectingInformation], map: "accounts_connecting_information_key")
  @@map("accounts")
}

/// 계정 변경 이력
model AccountChangeHistory {
  /// 변경 이력 ID
  accountChangeHistoryId Int                  @id @default(autoincrement()) @map("account_change_history_id")
  /// 계정
  accountId              Int                  @map("account_id")
  /// 변경 항목 — 휴대전화번호·이메일·주소·비밀번호
  field                  AccountChangeField
  /// 변경 전 값 — 비밀번호는 저장 안 함
  beforeValue            String?              @map("before_value")
  /// 변경 후 값 — 비밀번호는 저장 안 함
  afterValue             String?              @map("after_value")
  /// 변경 경로 — 본인·핀 재설정·관리자 초기화
  channel                AccountChangeChannel
  /// 요청 관리자 — 관리자 초기화일 때
  requestedBy            Int?                 @map("requested_by")
  /// 변경 일시
  changedAt              DateTime             @default(now()) @map("changed_at") @db.Timestamptz(6)
  account                Account              @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: NoAction, map: "account_change_histories_account_id_fkey")

  @@index([accountId, changedAt], map: "account_change_histories_account_id_changed_at_idx")
  @@map("account_change_histories")
}

/// 로그인 이력
model LoginHistory {
  /// 로그인 이력 ID
  loginHistoryId Int                        @id @default(autoincrement()) @map("login_history_id")
  /// 계정 — 없는 이메일이면 비움
  accountId      Int?                       @map("account_id")
  /// 시도 이메일
  email          String
  /// 성공 여부
  isSucceeded    Boolean                    @default(false) @map("is_succeeded")
  /// 실패 사유 — 안내 문구는 구분 안 함
  failureReason  AccountLoginFailureReason? @map("failure_reason")
  /// 시도 시각
  attemptedAt    DateTime                   @default(now()) @map("attempted_at") @db.Timestamptz(6)
  account        Account?                   @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: NoAction, map: "login_histories_account_id_fkey")

  @@index([accountId, attemptedAt], map: "login_histories_account_id_attempted_at_idx")
  @@map("login_histories")
}

/// 비밀번호 재설정 핀
model PasswordResetPin {
  /// 핀 ID
  passwordResetPinId Int       @id @default(autoincrement()) @map("password_reset_pin_id")
  /// 계정
  accountId          Int       @map("account_id")
  /// 핀 검증값 — 원본 저장 안 함
  pinHash            String    @map("pin_hash")
  /// 발급 시각 — 1분 재발급 제한, 하루 10회
  issuedAt           DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 만료 시각 — 15분 (ME-1)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  /// 시도 횟수 — 5회
  attemptCount       Int       @default(0) @map("attempt_count")
  /// 쿨다운 단계 — 1·3·5분, 3회까지
  cooldownStep       Int       @default(0) @map("cooldown_step")
  /// 쿨다운 해제 시각
  cooldownExpiresAt  DateTime? @map("cooldown_expires_at") @db.Timestamptz(6)
  /// 사용 시각
  usedAt             DateTime? @map("used_at") @db.Timestamptz(6)
  account            Account   @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: NoAction, map: "password_reset_pins_account_id_fkey")

  @@index([accountId], map: "password_reset_pins_account_id_idx")
  @@map("password_reset_pins")
}

/// 위치정보 확인자료
model LocationAccessLog {
  /// 확인자료 ID
  locationAccessLogId Int                  @id @default(autoincrement()) @map("location_access_log_id")
  /// 계정 — 대상 직원
  accountId           Int                  @map("account_id")
  /// 처리 구분 — 수집·이용·제공
  action              LocationAccessAction
  /// 처리 일시
  occurredAt          DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
