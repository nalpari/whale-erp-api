  todoId                 Int                 @id @default(autoincrement()) @map("todo_id")
  /// 근무지
  storeId                Int                 @map("store_id")
  /// 배정 그룹 ID — 전체·각자 수행 묶음
  assignmentGroupId      Int?                @map("assignment_group_id")
  /// 제목
  title                  String
  /// 내용
  body                   String?
  /// 배정 방식 — 개인·전체, 등록 후 변경 불가
  assigneeType           TodoAssigneeType    @map("assignee_type")
  /// 수행 방식 — 각자·공유, 등록 후 변경 불가
  executionMode          TodoExecutionMode   @map("execution_mode")
  /// 수행 예정 날짜 — 필수, 과거 날짜 불가
  dueDate                DateTime            @map("due_date") @db.Date
  /// 수행 시간 — 선택
  dueTime                DateTime?           @map("due_time") @db.Time(6)
  /// 긴급 여부 — 강조 표시, 미조치에 셈
  isUrgent               Boolean             @default(false) @map("is_urgent")
  /// 수행 상태 — 대기·진행 중·완료
  status                 TodoStatus          @default(PENDING)
  /// 수행자 — 공유 TO-DO
  performerStaffMemberId Int?                @map("performer_staff_member_id")
  /// 완료 일시
  completedAt            DateTime?           @map("completed_at") @db.Timestamptz(6)
  /// 등록 관리자
  createdBy              Int                 @map("created_by")
  /// 등록일
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 삭제 표시 — 대기일 때만 삭제
  isDeleted              Boolean             @default(false) @map("is_deleted")
  /// 최근 수정 일시
  updatedAt              DateTime            @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  performerStaffMember   StaffMember?        @relation(fields: [performerStaffMemberId], references: [staffMemberId], onDelete: Restrict, onUpdate: NoAction, map: "todos_performer_staff_member_id_fkey")
  todoAssignees          TodoAssignee[]
  todoStatusHistories    TodoStatusHistory[]

  @@index([storeId, dueDate], map: "todos_store_id_due_date_idx")
  @@map("todos")
}

/// TO-DO 배정 대상
