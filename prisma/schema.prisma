  bpCodeId              Int            @map("bp_code_id")
  /// 전체 점포 적용 여부 — true 면 전체 점포 휴일(예외 점포 제외), false 면 특정 점포 휴일(휴일-점포 매핑)
  isAllStores           Boolean        @default(false) @map("is_all_stores")
  /// 휴일 유형 코드 — 공통코드 `HOLIDAY_TYPE`(DAY 하루·PERIOD 기간·REPEAT 반복)
  holidayTypeCode       String         @map("holiday_type_code")
  /// 휴일 시작날짜 — 반복 기준일
  startDate             DateTime       @map("start_date") @db.Date
  /// 휴일 종료날짜 — 하루는 시작일과 같게 · 기간의 종료일 · 반복은 비움
  endDate               DateTime?      @map("end_date") @db.Date
  /// 휴일 반복 유형 코드 — 공통코드 `HOLIDAY_REPEAT_TYPE`(DAILY·WEEKLY·MONTHLY·YEARLY) · 반복일 때만, 하루·기간은 비움
  holidayRepeatTypeCode String?        @map("holiday_repeat_type_code")
  /// 반복 종료 조건 — 없음·날짜·횟수
  repeatEndType         RepeatEndType? @map("repeat_end_type")
  /// 반복 종료일
  repeatEndDate         DateTime?      @map("repeat_end_date") @db.Date
  /// 반복 횟수
  repeatCount           Int?           @map("repeat_count")
  /// 휴일명 — 30자
  name                  String
  /// 설명
  description           String?
  /// 원래 휴일 — bp_holidays 자기 참조, '이후 모두' 수정으로 분할된 경우
  originBpHolidayId     Int?           @map("origin_bp_holiday_id")
  /// 삭제 여부
  isDeleted             Boolean        @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자
  createdBy             Int?           @map("created_by")
  /// 최근 수정 일시
  updatedAt             DateTime       @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자
  updatedBy             Int?           @map("updated_by")

  bpCode          BpCode        @relation("BpHolidaysBpCode", fields: [bpCodeId], references: [bpCodeId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holidays_bp_code_id_fkey")
  originBpHoliday BpHoliday?    @relation("BpHolidaysOriginBpHoliday", fields: [originBpHolidayId], references: [bpHolidayId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holidays_origin_bp_holiday_id_fkey")
  creator         AdminAccount? @relation("BpHolidaysCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holidays_created_by_fkey")
  updater         AdminAccount? @relation("BpHolidaysUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holidays_updated_by_fkey")

  derivedBpHolidays BpHoliday[]              @relation("BpHolidaysOriginBpHoliday")
  storeMappings     HolidayStoreMapping[]    @relation("HolidayStoreMappingsBpHoliday")
  excludedStores    HolidayExcludedStore[]   @relation("HolidayExcludedStoresBpHoliday")
  changeHistories   BpHolidayChangeHistory[] @relation("BpHolidayChangeHistoriesBpHoliday")

  @@index([bpCodeId, startDate], map: "bp_holidays_bp_code_id_start_date_idx")
  @@map("bp_holidays")
}

/// 휴일 점포 매핑
model HolidayStoreMapping {
  /// 휴일 — bp_holidays FK
  bpHolidayId      Int       @map("bp_holiday_id")
  /// 대상 점포 — stores FK
  storeId          Int       @map("store_id")
  /// 적용 종료일 — 일부 점포를 빼거나 떼어 고칠 때 행을 지우지 않고 고른 날짜 전날을 넣는다 — 지난 날짜 보존
  effectiveEndDate DateTime? @map("effective_end_date") @db.Date
  /// 삭제 여부
  isDeleted        Boolean   @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy        Int?      @map("created_by")
  /// 최근 수정 일시
  updatedAt        DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy        Int?      @map("updated_by")

  bpHoliday BpHoliday     @relation("HolidayStoreMappingsBpHoliday", fields: [bpHolidayId], references: [bpHolidayId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_store_mappings_bp_holiday_id_fkey")
  store     Store         @relation("HolidayStoreMappingsStore", fields: [storeId], references: [storeId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_store_mappings_store_id_fkey")
  creator   AdminAccount? @relation("HolidayStoreMappingsCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_store_mappings_created_by_fkey")
  updater   AdminAccount? @relation("HolidayStoreMappingsUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_store_mappings_updated_by_fkey")

  @@id([bpHolidayId, storeId])
  @@index([storeId], map: "holiday_store_mappings_store_id_idx")
  @@map("holiday_store_mappings")
}

/// 휴일 예외 점포
model HolidayExcludedStore {
  /// 휴일 — bp_holidays FK
  bpHolidayId        Int      @map("bp_holiday_id")
  /// 예외 점포 — stores FK
  storeId            Int      @map("store_id")
  /// 적용 시작일 — 이 날짜부터 예외 — 지난 날짜 보존
  effectiveStartDate DateTime @map("effective_start_date") @db.Date
  /// 삭제 여부
  isDeleted          Boolean  @default(false) @map("is_deleted")
  /// 등록 일시
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 등록자 — admin_accounts FK
  createdBy          Int?     @map("created_by")
  /// 최근 수정 일시
  updatedAt          DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// 수정자 — admin_accounts FK
  updatedBy          Int?     @map("updated_by")

  bpHoliday BpHoliday     @relation("HolidayExcludedStoresBpHoliday", fields: [bpHolidayId], references: [bpHolidayId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_excluded_stores_bp_holiday_id_fkey")
  store     Store         @relation("HolidayExcludedStoresStore", fields: [storeId], references: [storeId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_excluded_stores_store_id_fkey")
  creator   AdminAccount? @relation("HolidayExcludedStoresCreatedBy", fields: [createdBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_excluded_stores_created_by_fkey")
  updater   AdminAccount? @relation("HolidayExcludedStoresUpdatedBy", fields: [updatedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "holiday_excluded_stores_updated_by_fkey")

  @@id([bpHolidayId, storeId])
  @@index([storeId], map: "holiday_excluded_stores_store_id_idx")
  @@map("holiday_excluded_stores")
}

/// BP 휴일 변경 이력
model BpHolidayChangeHistory {
  /// 변경 이력 ID
  changeId    Int      @id @default(autoincrement()) @map("change_id")
  /// 휴일
  bpHolidayId Int      @map("bp_holiday_id")
  /// 변경 항목
  field       String
  /// 변경 전 값
  beforeValue String?  @map("before_value")
  /// 변경 후 값
  afterValue  String?  @map("after_value")
  /// 변경자
  changedBy   Int?     @map("changed_by")
  /// 변경 일시 — 5년 보존
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  bpHoliday BpHoliday     @relation("BpHolidayChangeHistoriesBpHoliday", fields: [bpHolidayId], references: [bpHolidayId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holiday_change_histories_bp_holiday_id_fkey")
  changer   AdminAccount? @relation("BpHolidayChangeHistoriesChangedBy", fields: [changedBy], references: [adminAccountId], onDelete: Restrict, onUpdate: NoAction, map: "bp_holiday_change_histories_changed_by_fkey")

  @@index([bpHolidayId, changedAt], map: "bp_holiday_change_histories_bp_holiday_id_changed_at_idx")
  @@map("bp_holiday_change_histories")
}

/// 플랫폼 공식 휴일
model PublicHoliday {
  /// 공식 휴일 ID
  publicHolidayId Int                 @id @default(autoincrement()) @map("public_holiday_id")
  /// 날짜 — 한 날짜에 한 건
  holidayDate     DateTime            @map("holiday_date") @db.Date
  /// 연도 — 2000~2100
  year            Int
  /// 휴일명
  name            String
  /// 비고
  note            String?
  /// 출처 — 규칙 계산·공식 API
  source          PublicHolidaySource
  /// 공식 원본 식별자 — 공식 API일 때만
  sourceRef       String?             @map("source_ref")
  /// 최종 동기화 일시 — 공식 API일 때만
  synchronizedAt  DateTime?           @map("synchronized_at") @db.Timestamptz(6)

  @@unique([holidayDate], map: "public_holidays_holiday_date_key")
  @@index([year], map: "public_holidays_year_idx")
  @@map("public_holidays")
}

/// 동기화 이력
model PublicHolidaySynchronizationLog {
  /// 동기화 이력 ID
  synchronizationId Int           @id @default(autoincrement()) @map("synchronization_id")
  /// 대상 연도 — 올해·다음 해
  year              Int
  /// 동기화 일시
  synchronizedAt    DateTime      @default(now()) @map("synchronized_at") @db.Timestamptz(6)
  /// 등록 건수
  createdCount      Int           @default(0) @map("created_count")
  /// 수정 건수
  updatedCount      Int           @default(0) @map("updated_count")
  /// 삭제 건수
  deletedCount      Int           @default(0) @map("deleted_count")
  /// 실패 건수
  failedCount       Int           @default(0) @map("failed_count")
  /// 오류 정보
  error             String?
  /// 결과 — 성공·실패
  result            ProcessResult

  @@map("public_holiday_synchronization_logs")
}
