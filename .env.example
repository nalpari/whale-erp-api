# 프로파일별 env 템플릿.
# 실제 값 파일(.env.local/.env.dev/.env.prod)은 추적되지 않으므로,
# 새 키를 추가하면 이 파일에도 키를 추가해 공유한다. 값은 비워 둔다.

# Node/라이브러리가 해석하는 값. production 이외에는 development 를 쓴다.
NODE_ENV=

# 애플리케이션 프로파일: local | dev | prod
APP_ENV=

# 서버가 열 포트. 미설정 시 8000.
PORT=

# 믿을 프록시(직원 앱 Next 서버, 그 앞의 로드밸런서)의 주소. 쉼표로 나눈 IP · CIDR ·
# loopback · linklocal · uniquelocal. 적은 주소에서 온 요청은 X-Forwarded-For 의
# 클라이언트 IP 로 요청 제한을 센다. 비우면 끈다(소켓 주소가 곧 클라이언트). 단 운영
# (APP_ENV=prod 또는 NODE_ENV=production)에서는 비우면 기동이 멈춘다 — 모든 방문자가 한 IP 버킷이 되기 때문이다.
# 클라이언트도 있을 수 있는 대역보다 프록시 자신의 주소를 적는다. Next 서버는
# X-Forwarded-For 를 직접 넣어야 한다(서버 쪽 fetch 는 붙이지 않는다).
# true · 단계 수(1)와 IPv4 전체를 믿게 되는 IPv6 대역(::/8, ::ffff:…)은 api 에
# 프록시를 거치지 않고 닿으면 헤더로 IP 를 지어낼 수 있게 하므로 부팅 단계에서 멈춘다.
# 예) TRUST_PROXY=10.0.1.5,10.0.2.0/24
TRUST_PROXY=

# JWT 서명 키. 32바이트 이상의 무작위 문자열.
# 기본값이 없고 길이도 검사한다. 비었거나 32바이트 미만이면 부팅 단계에서 멈춘다.
# HS256 은 짧은 키도 받아들이므로, 막지 않으면 토큰 하나로 키를 깰 수 있다.
# 예) node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 비즈뿌리오(카카오 알림톡). AlimtalkModule 을 import 하는 순간 앞의 넷이 필요하고,
# 하나라도 비면 부팅 단계에서 멈춘다.
# 검수 https://dev-api.bizppurio.com · 운영 https://api.bizppurio.com
BIZPPURIO_BASE_URL=
BIZPPURIO_ACCOUNT=
BIZPPURIO_PASSWORD=
BIZPPURIO_SENDER_KEY=
# 알림톡 실패 때 문자 대체 발송의 발신번호. 비즈뿌리오에 등록된 번호(하이픈은 떼고 쓴다).
# 비우면 문자 대체 발송을 하지 않는다(기본).
BIZPPURIO_SMS_FROM=

# Gmail SMTP 메일 발송. AuthModule 이 MailModule 을 import 하므로 앱이 뜨려면 둘 다 필요하고,
# 하나라도 비면 부팅 단계에서 멈춘다. 비밀번호는 Google 계정의 앱 비밀번호다.
# 관리자 초기화 재설정 링크는 둘 다 비면 발송만 503 이고, 하나만 넣으면 기동이 멈춘다.
# 문의 답변 메일은 둘 다 비면 메일만 건너뛴다(답변 저장과 운영 알림은 된다).
MAIL_USERNAME=
MAIL_PASSWORD=
# 직원 앱 주소. 관리자 초기화 재설정 링크가 <이 주소의 origin>/password-reset/link#token=… 로 간다
# (주소에 경로가 있으면 버린다).
# 운영은 https 만. 비우면 api 는 뜨고 링크 발송만 503 이다.
STAFF_APP_URL=

# 관리자 웹(whale-erp-front) 주소. 메일의 바로가기 버튼이 <이 주소><화면 경로> 로 간다 — 플랫폼 관리자
# 초기 · 초기화 비밀번호 메일(주소 그대로), BP 회원가입 메일(api #16), 문의 답변 메일(/support/inquiries/<id>).
# 위 MAIL_* 와 이 값이 다 있어야 그 메일들을 보낸다. 비우면 api 는 뜨고 메일만 보내지 않는다.
# http(s) 주소가 아니면 기동이 멈추고, 운영(APP_ENV=prod)은 https 만 받는다. 끝의 / 는 뗀다.
# 예) http://localhost:3000
ADMIN_WEB_URL=
