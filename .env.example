# 프로파일별 env 템플릿.
# 실제 값 파일(.env.local/.env.dev/.env.prod)은 추적되지 않으므로,
# 새 키를 추가하면 이 파일에도 키를 추가해 공유한다. 값은 비워 둔다.

# Node/라이브러리가 해석하는 값. production 이외에는 development 를 쓴다.
NODE_ENV=

# 애플리케이션 프로파일: local | dev | prod
APP_ENV=

# 서버가 열 포트. 미설정 시 8000.
PORT=

# 믿을 프록시(직원 앱 Next 서버, 그 앞의 로드밸런서)의 주소. 쉼표로 나눈 IP · CIDR ·
# loopback · linklocal · uniquelocal. 적은 주소에서 온 요청은 X-Forwarded-For 의
# 클라이언트 IP 로 요청 제한을 센다. 비우면 끈다(소켓 주소가 곧 클라이언트). 단 운영
# (APP_ENV=prod 또는 NODE_ENV=production)에서는 비우면 기동이 멈춘다 — 모든 방문자가 한 IP 버킷이 되기 때문이다.
# 클라이언트도 있을 수 있는 대역보다 프록시 자신의 주소를 적는다. Next 서버는
# X-Forwarded-For 를 직접 넣어야 한다(서버 쪽 fetch 는 붙이지 않는다).
# true · 단계 수(1)와 IPv4 전체를 믿게 되는 IPv6 대역(::/8, ::ffff:…)은 api 에
# 프록시를 거치지 않고 닿으면 헤더로 IP 를 지어낼 수 있게 하므로 부팅 단계에서 멈춘다.
# 예) TRUST_PROXY=10.0.1.5,10.0.2.0/24
TRUST_PROXY=

# JWT 서명 키. 32바이트 이상의 무작위 문자열.
# 기본값이 없고 길이도 검사한다. 비었거나 32바이트 미만이면 부팅 단계에서 멈춘다.
# HS256 은 짧은 키도 받아들이므로, 막지 않으면 토큰 하나로 키를 깰 수 있다.
# 예) node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 비즈뿌리오(카카오 알림톡). 근로계약 발송(ContractsModule)이 AlimtalkModule 을 import 해 api 가 뜨려면
# 앞의 넷이 늘 필요하고, 하나라도 비면 부팅 단계에서 멈춘다(2026-10-16).
# 검수 https://dev-api.bizppurio.com · 운영 https://api.bizppurio.com
BIZPPURIO_BASE_URL=
BIZPPURIO_ACCOUNT=
BIZPPURIO_PASSWORD=
BIZPPURIO_SENDER_KEY=
# 알림톡 실패 때 문자 대체 발송의 발신번호. 비즈뿌리오에 등록된 번호(하이픈은 떼고 쓴다).
# 비우면 문자 대체 발송을 하지 않는다(기본). 알림톡 버튼을 아직 보내지 않아 초대 링크는 대체 문자로만 가고 바뀐
# 본문은 카카오 재검수 전이라, 비어 있으면 근로계약 가입 초대는 503 으로 막힌다.
BIZPPURIO_SMS_FROM=

# Gmail SMTP 메일 발송. 비밀번호는 Google 계정의 앱 비밀번호다(계정 비밀번호는 거절된다).
# 관리자 초기화 재설정 링크는 둘 다 비면 발송만 503, 관리자 임시 비밀번호는 메일 없이 같은 202 이고, 하나만 넣으면 기동이 멈춘다.
# 문의 답변 메일은 둘 다 비면 메일만 건너뛴다(답변 저장과 운영 알림은 된다).
MAIL_USERNAME=
MAIL_PASSWORD=
# 직원 앱 주소. 관리자 초기화 재설정 링크가 <이 주소의 origin>/password-reset/link#token=… 로 간다
# (주소에 경로가 있으면 버린다).
# 운영은 https 만. 비우면 api 는 뜨고 링크 발송만 503 이다.
STAFF_APP_URL=

# 관리자 웹(whale-erp-front) 주소. 메일의 바로가기 버튼이 <이 주소><화면 경로> 로 간다 — 플랫폼 관리자
# 초기 · 초기화 비밀번호 메일(주소 그대로), 관리자 임시 비밀번호 메일(/login), BP 회원가입 메일(api #16),
# 문의 답변 메일(/support-inquiries/<id>), 엑셀 예약 생성 완료 메일(/excel-downloads/<id>).
# 위 MAIL_* 와 이 값이 다 있어야 그 메일들을 보낸다. 비우면 api 는 뜨고 메일만 보내지 않는다(임시 비밀번호 발급도 같은 202).
# 엑셀은 1만 건 이상 예약 생성만 503 이다 — 만들어도 알릴 수 없어서(1만 건 미만은 그대로 받는다).
# http(s) 주소가 아니면 기동이 멈추고, 운영(APP_ENV=prod)은 https 만 받는다. 끝의 / 는 뗀다.
# 예) http://localhost:3000
ADMIN_WEB_URL=

# 공공데이터포털 「국세청_사업자등록정보 진위확인 및 상태조회」 서비스 키. 회원가입 · 점포의 사업자 진위확인이 쓴다.
# 포털의 Encoding · Decoding 키 어느 쪽이든 된다. 비워도 api 는 뜨고 회원가입 · 점포의 사업자 진위확인만
# 503 이다(가입은 인증 없이 된다). 운영(APP_ENV=prod)에서 비우면 기동 때 error 로그가 남는다.
NTS_SERVICE_KEY=

# 공공데이터포털 「한국천문연구원_특일 정보」 서비스 키(공휴일 정보 조회). 매월 1일 공식 휴일 동기화 배치가 쓴다.
# 같은 포털 계정이면 위 국세청 키와 값이 같다 — 그 계정으로 특일 정보를 활용신청해야 통한다. Encoding · Decoding 어느 쪽이든 된다.
# 비워도 api 는 뜨고 동기화만 실패 이력을 남긴다. 운영(APP_ENV=prod)에서 비우면 기동 때 error 로그가 남는다.
HOLIDAY_SERVICE_KEY=

# 개인정보(주민등록번호 · 급여 계좌) 암호화 키. base64 로 쓴 32바이트(AES-256-GCM). 길이가 틀리면 기동을 막는다.
# 비워도 api 는 뜨고, 있는 신고 정보를 읽을 때만 503 이다(기동 때 운영은 error, 그 밖은 warn 로그). 바꾸면 옛 값을 풀 수 없으니 환경마다 한 번 정해 보관한다.
# 예) node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PERSONAL_DATA_ENCRYPTION_KEY=

# 첨부파일 저장소(AWS S3). 1차 버킷을 같이 쓰고, 1차가 쓰는 맨 앞 폴더(images/ · attachments/)와
# 겹치지 않게 키를 짓는다 — images/ 는 버킷 정책으로 공개된다 (운영 정책 CNT-18).
# 엑셀 예약 생성 파일은 excel-exports/ 아래에 둔다 — 24시간 기한이 지나면 api 의 매일 정리 배치가 지운다. 놓친 것을
# 막도록 버킷에 이 접두사만 1~2일 뒤 지우는 수명 주기 규칙도 걸어 두면 좋다(1차와 같은 버킷이라 반드시 접두사로 좁힌다).
# 예) AWS_S3_BUCKET=whale-erp-files · AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_REGION=
# AWS SDK 가 이 이름 그대로 읽는다. 배포 서버에 IAM 역할을 붙이면 비워 둔다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
