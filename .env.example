# 프로파일별 env 템플릿.
# 실제 값 파일(.env.local/.env.dev/.env.prod)은 추적되지 않으므로,
# 새 키를 추가하면 이 파일에도 키를 추가해 공유한다. 값은 비워 둔다.

# Node/라이브러리가 해석하는 값. production 이외에는 development 를 쓴다.
NODE_ENV=

# 애플리케이션 프로파일: local | dev | prod
APP_ENV=

# src/main.ts 가 읽는 유일한 변수. 미설정 시 8000.
PORT=

# JWT 서명 키. 32바이트 이상의 무작위 문자열.
# 기본값이 없어, 비어 있으면 앱이 부팅 단계에서 멈춘다.
# 예) node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
