#!/bin/sh
# push 직전 마이그레이션 검사 (3팀 채널 2026-10-08 합의, CLAUDE.md 「Migration rules」).
#   1. 이미 main 에 있는 마이그레이션 파일을 고치거나 지우지 않았는가
#   2. 새 마이그레이션 이름이 main 의 마지막 것보다 뒤에 정렬되는가
#   3. 앞 14자리(시각)가 겹치는 마이그레이션이 없는가
# 기준은 origin/main 이다. main 자체를 push 할 때는 1·3 만 본다.
# 급할 때 건너뛰려면 git push --no-verify (머지 전에는 꼭 다시 확인한다).
set -e
base=origin/main
git rev-parse -q --verify "$base" >/dev/null || exit 0
dir=prisma/migrations
fail=0

changed=$(git diff --name-only --diff-filter=MDR "$base" HEAD -- "$dir" | grep -v '/migration_lock.toml$' || true)
if [ -n "$changed" ]; then
  echo "[pre-push] main 에 있는 마이그레이션을 고쳤거나 지웠습니다. 적용된 마이그레이션은 고치지 않고 새로 만듭니다:" >&2
  printf '  %s\n' $changed >&2
  fail=1
fi

if [ "$(git rev-parse --abbrev-ref HEAD)" != "main" ]; then
  last=$(git ls-tree --name-only "$base" "$dir/" | sed "s#^$dir/##" | grep '^[0-9]' | sort | tail -1)
  for m in $(git diff --name-only --diff-filter=A "$base" HEAD -- "$dir" | sed -n "s#^$dir/\([0-9][^/]*\)/.*#\1#p" | sort -u); do
    if [ "$m" \< "$last" ] || [ "$m" = "$last" ]; then
      echo "[pre-push] $m 이 main 의 마지막 마이그레이션 $last 보다 앞입니다. 폴더 이름을 지금 시각(TZ=Asia/Seoul date +%Y%m%d%H%M%S)으로 바꾸세요." >&2
      fail=1
    fi
  done
fi

dup=$(git ls-tree --name-only HEAD "$dir/" | sed "s#^$dir/##" | grep '^[0-9]' | cut -c1-14 | sort | uniq -d)
if [ -n "$dup" ]; then
  echo "[pre-push] 시각이 겹치는 마이그레이션이 있습니다: $dup" >&2
  fail=1
fi

exit $fail
